@model CareerConnect.Models.Profile

@{
    ViewData["Title"] = "My Profile";
}

<h2>My Profile</h2>

<table class="table table-bordered">

    <tr>
        <th>Full Name</th>
        <td>@Model.FullName</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>

    <tr>
        <th>Mobile Number</th>
        <td>@Model.MobileNumber</td>
    </tr>

    <tr>
        <th>AboutMe</th>
        <td>@Model.AboutMe</td>
    </tr>

    <tr>
        <th>City</th>
        <td>@Model.City</td>
    </tr>

    <tr>
        <th>State</th>
        <td>@Model.State</td>
    </tr>

    <tr>
        <th>Qualification</th>
        <td>@Model.Qualification</td>
    </tr>

    <tr>
        <th>Skills</th>
        <td>@Model.Skills</td>
    </tr>

    <tr>
        <th>Profile Image</th>
        <td>@Model.ProfileImage</td>
    </tr>

</table>

<a asp-action="Edit" class="btn btn-warning">
    Edit Profile
</a>