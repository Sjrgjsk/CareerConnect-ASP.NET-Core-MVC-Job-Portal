@model CareerConnect.Models.Resume

@{
    ViewData["Title"] = "Upload Resume";
}

<h2 class="text-primary mb-4">
    <i class="bi bi-file-earmark-arrow-up"></i>
    Upload Resume
</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <div class="card shadow p-4">

    <div class="mb-3">
        <label asp-for="ResumeTitle" class="form-label"></label>
        <input asp-for="ResumeTitle" class="form-control" />
        <span asp-validation-for="ResumeTitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Select Resume (PDF/DOC/DOCX)</label>
        <input type="file" name="ResumeUpload" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Upload Resume
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}