@model CareerConnect.Models.Company

@{
    ViewData["Title"] = "Delete Company";
}

<h2 class="text-danger">Delete Company</h2>

<h4>Are you sure you want to delete this company?</h4>

<hr />

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">Company Name</dt>
            <dd class="col-sm-9">@Model.CompanyName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Phone Number</dt>
            <dd class="col-sm-9">@Model.PhoneNumber</dd>

            <dt class="col-sm-3">Website</dt>
            <dd class="col-sm-9">@Model.Website</dd>

            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">@Model.Address</dd>

        </dl>

        <form asp-action="Delete">

            <input type="hidden" asp-for="CompanyId" />

            <button type="submit" class="btn btn-danger">
                Delete
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>