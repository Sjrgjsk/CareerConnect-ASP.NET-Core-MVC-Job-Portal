@{
    ViewData["Title"] = "Recruiter Dashboard";
}

<div class="container mt-4">

    <!-- Heading -->

    <div class="mb-4">

        <h2 class="text-primary">
            <i class="bi bi-speedometer2"></i>
            Recruiter Dashboard
        </h2>

        <p class="text-muted">
            Welcome, @User.Identity?.Name
        </p>

    </div>

    <!-- Statistics -->

    <div class="row">

        <div class="col-md-4 mb-4">

            <div class="card shadow border-0 bg-primary text-white">

                <div class="card-body text-center">

                    <i class="bi bi-briefcase-fill display-4"></i>

                    <h5 class="mt-3">Total Jobs</h5>

                    <h2>@ViewBag.TotalJobs</h2>

                </div>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="card shadow border-0 bg-success text-white">

                <div class="card-body text-center">

                    <i class="bi bi-file-earmark-text-fill display-4"></i>

                    <h5 class="mt-3">Applications</h5>

                    <h2>@ViewBag.TotalApplications</h2>

                </div>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="card shadow border-0 bg-warning text-dark">

                <div class="card-body text-center">

                    <i class="bi bi-hourglass-split display-4"></i>

                    <h5 class="mt-3">Pending</h5>

                    <h2>@ViewBag.PendingApplications</h2>

                </div>

            </div>

        </div>

        <div class="col-md-6 mb-4">

            <div class="card shadow border-0 bg-info text-white">

                <div class="card-body text-center">

                    <i class="bi bi-check-circle-fill display-4"></i>

                    <h5 class="mt-3">Accepted</h5>

                    <h2>@ViewBag.AcceptedApplications</h2>

                </div>

            </div>

        </div>

        <div class="col-md-6 mb-4">

            <div class="card shadow border-0 bg-danger text-white">

                <div class="card-body text-center">

                    <i class="bi bi-x-circle-fill display-4"></i>

                    <h5 class="mt-3">Rejected</h5>

                    <h2>@ViewBag.RejectedApplications</h2>

                </div>

            </div>

        </div>

    </div>

    <!-- Quick Actions -->

    <h4 class="mb-3">

        <i class="bi bi-lightning-fill text-warning"></i>

        Quick Actions

    </h4>

    <div class="mb-5">

        <a asp-controller="Job"
           asp-action="Create"
           class="btn btn-primary me-2">

            <i class="bi bi-plus-circle"></i>

            Post Job

        </a>

        <a asp-controller="Job"
           asp-action="Index"
           class="btn btn-success me-2">

            <i class="bi bi-briefcase"></i>

            Manage Jobs

        </a>

        <a asp-controller="Company"
           asp-action="Index"
           class="btn btn-warning">

            <i class="bi bi-buildings"></i>

            Companies

        </a>

    </div>

    <!-- Recent Jobs -->

    <h4 class="mb-3">

        <i class="bi bi-clock-history text-primary"></i>

        Recently Posted Jobs

    </h4>

    <table class="table table-hover table-bordered shadow">

        <thead class="table-primary">

            <tr>

                <th>Job Title</th>

                <th>Location</th>

                <th>Job Type</th>

                <th>Posted Date</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var job in ViewBag.RecentJobs)
            {
                <tr>

                    <td>@job.JobTitle</td>

                    <td>@job.Location</td>

                    <td>@job.JobType</td>

                    <td>@job.PostedDate.ToShortDateString()</td>

                </tr>
            }

        </tbody>

    </table>

    <!-- Recent Applications -->

    <h4 class="mt-5 mb-3">

        <i class="bi bi-people-fill text-success"></i>

        Recent Applications

    </h4>

    <table class="table table-hover table-bordered shadow">

        <thead class="table-success">

            <tr>

                <th>Applicant</th>

                <th>Job</th>

                <th>Status</th>

                <th>Applied Date</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var app in ViewBag.RecentApplications)
            {
                <tr>

                    <td>@app.User?.FullName</td>

                    <td>@app.Job?.JobTitle</td>

                    <td>

                        @if (app.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                        else if (app.Status == "Accepted")
                        {
                            <span class="badge bg-success">Accepted</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }

                    </td>

                    <td>@app.ApplicationDate.ToShortDateString()</td>

                </tr>
            }

        </tbody>

    </table>

</div>