@model CareerConnect.Models.Job

@{
    ViewData["Title"] = "Job Details";
}

<h2>Job Details</h2>

<table class="table table-bordered">

    <tr>
        <th>Job Title</th>
        <td>@Model.JobTitle</td>
    </tr>

    <tr>
        <th>Company</th>
        <td>@Model.Company?.CompanyName</td>
    </tr>

    <tr>
        <th>Category</th>
        <td>@Model.Category?.CategoryName</td>
    </tr>

    <tr>
        <th>Location</th>
        <td>@Model.Location</td>
    </tr>

    <tr>
        <th>Salary</th>
        <td>@Model.Salary</td>
    </tr>

    <tr>
        <th>Description</th>
        <td>@Model.Description</td>
    </tr>

    <tr>
        <th>Last Date</th>
        <td>@Model.LastDateToApply.ToShortDateString()</td>
    </tr>

</table>

<a asp-action="Edit"
   asp-route-id="@Model.JobId"
   class="btn btn-warning">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>