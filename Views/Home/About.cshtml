@{
    ViewData["Title"] = "About";
}

<div class="container mt-5">

    <h2 class="text-primary">
        About CareerConnect
    </h2>

    <hr />

    <p>
        CareerConnect is an Online Job Portal developed using
        ASP.NET Core MVC, Entity Framework Core and SQL Server.
    </p>

    <p>
        This application helps companies post jobs and allows
        job seekers to search and apply for jobs online.
    </p>

    <h4>Features</h4>

    <ul>
        <li>User Registration</li>
        <li>User Login</li>
        <li>Company Registration</li>
        <li>Post Jobs</li>
        <li>Search Jobs</li>
        <li>Apply Jobs</li>
        <li>Resume Upload</li>
        <li>Saved Jobs</li>
        <li>Admin Dashboard</li>
    </ul>

</div>