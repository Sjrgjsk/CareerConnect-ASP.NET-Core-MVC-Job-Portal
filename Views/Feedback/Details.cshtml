@model CareerConnect.Models.Feedback

@{
    ViewData["Title"] = "Feedback Details";
}

<h2>Feedback Details</h2>

<table class="table table-bordered">

    <tr>
        <th>Subject</th>
        <td>@Model.Subject</td>
    </tr>

    <tr>
        <th>Message</th>
        <td>@Model.Message</td>
    </tr>

    <tr>
        <th>User</th>
        <td>@Model.User?.FullName</td>
    </tr>

    <tr>
        <th>Date</th>
        <td>@Model.FeedbackDate.ToShortDateString()</td>
    </tr>

</table>

<a asp-action="Index" class="btn btn-secondary">
    Back
</a>